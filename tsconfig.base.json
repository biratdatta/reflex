{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@reflex/capability-model": ["packages/capability-model/src/index.ts"],
      "@reflex/discovery-engine": ["packages/discovery-engine/src/index.ts"],
      "@reflex/schema-generator": ["packages/schema-generator/src/index.ts"],
      "@reflex/webmcp-adapter": ["packages/webmcp-adapter/src/index.ts"]
    }
  }
}
